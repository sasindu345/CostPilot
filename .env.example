# CostPilot settings.
# Copy this file to .env (`make setup` does it for you) and fill in the blanks.
# Never put real values in this file. It is committed to Git.

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Ports on your computer ----
API_PORT=8010
WEB_PORT=3010
POSTGRES_PORT=5433
QDRANT_PORT=6333
KEYCLOAK_PORT=8090
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---- Frontend ----
# Where the web app finds the API. Inside Docker this is the service name.
API_INTERNAL_URL=http://api:8000

# ---- PostgreSQL ----
POSTGRES_USER=costpilot_admin
POSTGRES_PASSWORD=
POSTGRES_DB=costpilot
KEYCLOAK_DB_PASSWORD=

# ---- Keycloak (login service) ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# ---- Gemini (filled in from Phase 5) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free or paid. See docs/guides/getting-started.md before uploading real bills.
GEMINI_TIER=free
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
