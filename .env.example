# CostPilot settings.
# Copy this file to .env (`make setup` does it for you) and fill in the blanks.
# Never put real values in this file. It is committed to Git.

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Ports on your computer ----
API_PORT=8010
WEB_PORT=3010
POSTGRES_PORT=5433
QDRANT_PORT=6333
KEYCLOAK_PORT=8090
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---- Web addresses ----
# The address people use in their browser.
APP_PUBLIC_URL=http://localhost:3010
# Where the web app finds the API. Inside Docker this is the service name.
API_INTERNAL_URL=http://api:8000

# ---- PostgreSQL ----
# The admin user only runs migrations. The app user is low-power on purpose.
POSTGRES_HOST=localhost
POSTGRES_USER=costpilot_admin
POSTGRES_PASSWORD=
POSTGRES_APP_USER=costpilot_app
POSTGRES_APP_PASSWORD=
POSTGRES_DB=costpilot
KEYCLOAK_DB_PASSWORD=

# ---- Keycloak (login service) ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=costpilot
KEYCLOAK_CLIENT_ID=costpilot-api
KEYCLOAK_CLIENT_SECRET=
# The address browsers use, and the address the backend uses.
KEYCLOAK_PUBLIC_URL=http://localhost:8090
KEYCLOAK_INTERNAL_URL=http://localhost:8090
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@costpilot.local

# ---- Login sessions ----
SESSION_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=costpilot_session
SESSION_LIFETIME_HOURS=8
# Must be true in production, where the site uses HTTPS.
SESSION_COOKIE_SECURE=false

# ---- File storage ----
# local keeps files in a folder. s3 uses Amazon S3 and is for production.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../../uploads
S3_BUCKET=
AWS_REGION=

# ---- Documentation search ----
# Locally this is the Qdrant container. In production it is Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
AWS_DOCS_URL=https://docs.aws.amazon.com

# ---- Gemini (filled in from Phase 5) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free or paid. See docs/guides/getting-started.md before uploading real bills.
GEMINI_TIER=free
GEMINI_ANSWER_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
